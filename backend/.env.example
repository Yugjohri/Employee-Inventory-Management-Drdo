# Copy to .env and adjust for your machine.
#
# Everything here points at a PostgreSQL server you control. There are no
# external services and no internet access is required at any point.

# --- Database ---------------------------------------------------------------
# The API connects as `eims_app`, NOT as postgres. That is deliberate: Postgres
# exempts a table's owner from its own row-level security, so connecting as the
# owner would silently switch off every access rule in 01_schema.sql.
PGHOST=localhost
PGPORT=5432
PGDATABASE=eims
PGUSER=eims_app
PGPASSWORD=change-me-in-production

# Used by `npm run migrate` only, which needs owner rights to create tables.
# If you installed PostgreSQL normally, this is the superuser password you
# chose during installation.
ADMIN_PGUSER=postgres
ADMIN_PGPASSWORD=postgres

# --- Portable PostgreSQL only ------------------------------------------------
# Leave these blank if PostgreSQL was installed normally (it runs as a service
# and starts with the machine). Set them only if you are using the zip download
# that runs from a folder, so `npm run db:start` knows where it lives.
PG_BIN=
PG_DATA=

# --- API --------------------------------------------------------------------
PORT=4000

# Signs the session cookie. Generate a fresh one per deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login lasts before the user must sign in again.
SESSION_HOURS=12

# Password given to newly created accounts and to `npm run seed` demo logins.
DEFAULT_PASSWORD=drdo@1234
